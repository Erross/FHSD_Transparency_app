{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/greenwood-repository/target.schema.json",
  "title": "Archive target",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "platform", "sourceUrls", "authorAliases", "crawl"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "platform": {"type": "string", "minLength": 1},
    "sourceUrls": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorAliases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "crawl": {"type": "object", "required": ["comparisonMode", "requiresCompleteSnapshotForMissing"]},
    "publicNotes": {"type": "string"}
  }
}
